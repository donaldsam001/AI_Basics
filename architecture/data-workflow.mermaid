flowchart TB
 subgraph subGraph0["System Architecture"]
        A["User"]
        B["POST /api/v1/match/upload"]
        C["HTTP Multipart Request<br>CV file PDF/DOCX<br>job JSON"]
        D["Validate File Size/Type"]
        E["File Bytes"]
        F["PDF/DOCX Extraction<br>PyPDF2, python-docx"]
        G["Raw CV Text"]
        H["CV Preprocessing<br>normalize, clean text"]
        I["Structured Candidate<br>name, skills, experience<br>education"]
        J["Candidate + Job<br>pair representation"]
  end
 subgraph subGraph1["Flow 1: Job → Top-K Candidates Matching"]
        K["Feature Engineering"]
        L["Pair Features"]
        M["XGBoost Model"]
        N["Match Probability"]
        O{"explain=true?"}
        P["Evidence Builder"]
        Q["Matching Evidence<br>candidate content<br>job content<br>feature alignment"]
        R["Qwen Prompt Builder"]
        S["Qwen Prompt"]
        T["Qwen LLM"]
        U["Evidence-based Explanation"]
        V["API Response<br>match_probability<br>explanation<br>explanation_status"]
        W["HTTP 200 OK"]
        X["Qwen LLM"]
        Y["Evidence-based Explanation"]
        Z["Final JSON Response<br>candidates, scores, explanation"]
        AA["HTTP Response 200 OK"]
  end
 subgraph subGraph2["Flow 2: CV Upload → Matching → Explanation"]
  end
